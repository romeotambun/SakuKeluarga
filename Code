function safeParseDate(dateObj) {
  try {
    if (dateObj instanceof Date) return dateObj.toISOString();
    if (dateObj) {
      var str = dateObj.toString().trim();
      var parsedDate = new Date(str);
      if (!isNaN(parsedDate.getTime())) return parsedDate.toISOString();
      
      var parts = str.split(/[\/\s:]/);
      if (parts.length >= 6) {
        var d = new Date(parseInt(parts[2], 10), parseInt(parts[0], 10) - 1, parseInt(parts[1], 10), parseInt(parts[3], 10), parseInt(parts[4], 10), parseInt(parts[5], 10));
        if (!isNaN(d.getTime())) return d.toISOString();
      }
    }
  } catch (e) {}
  return new Date().toISOString();
}

