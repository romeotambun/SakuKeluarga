// FUNGSI BANTUAN PARSING TANGGAL ULTRA AMAN UNTUK MENCEGAH CRASH NULL RESPONSE
function safeParseDate(dateObj) {
  try {
    if (dateObj instanceof Date) {
      return dateObj.toISOString();
    }
    if (dateObj) {
      var str = dateObj.toString().trim();
      var parsedDate = new Date(str);
      if (!isNaN(parsedDate.getTime())) {
        return parsedDate.toISOString();
      }
      
      // Mengurai format kustom terlokalisasi Sheets: "6/30/2026 0:17:2" -> M/D/YYYY H:M:S
      var parts = str.split(/[\/\s:]/);
      if (parts.length >= 6) {
        var month = parseInt(parts[0], 10) - 1;
        var day = parseInt(parts[1], 10);
        var year = parseInt(parts[2], 10);
        var hour = parseInt(parts[3], 10);
        var min = parseInt(parts[4], 10);
        var sec = parseInt(parts[5], 10);
        
        var d = new Date(year, month, day, hour, min, sec);
        if (!isNaN(d.getTime())) {
          return d.toISOString();
        }
      }
    }
  } catch (e) {}
  return new Date().toISOString(); // Fallback akhir aman jika semua parsing gagal
}

// 1. REGISTRASI (DENGAN CEK DUPLIKAT EMAIL CASE-INSENSITIVE)
