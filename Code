function forgotPassword(email) {
  try {
    const masterSs = SpreadsheetApp.openById(MASTER_SHEET_ID);
    const userSheet = masterSs.getSheetByName("Users");
    const data = userSheet.getDataRange().getValues();
    const searchEmail = email.toLowerCase().trim();
    
    let rowIndex = -1;
    for (let i = 1; i < data.length; i++) {
      if (data[i][0].toString().toLowerCase().trim() === searchEmail) {
        rowIndex = i + 1;
        break;
      }
    }
    if (rowIndex === -1) return { success: false, message: "Email tidak ditemukan!" };
    
    const otp = Math.floor(100000 + Math.random() * 900000).toString();
    userSheet.getRange(rowIndex, 4).setValue(otp);
    
    MailApp.sendEmail({
      to: email,
      subject: "[SakuHarmoni] Kode Keamanan Verifikasi Setel Ulang Sandi",
      body: "Gunakan Kode Keamanan OTP berikut untuk memverifikasi akun Anda:\n\n▶ OTP: " + otp
    });
    return { success: true, message: "Kode keamanan OTP berhasil dikirim ke email!" };
  } catch (e) {
    return { success: false, message: "Gagal memproses OTP: " + e.toString() };
  }
}

function resetPasswordWithCode(email, otpCode, newPassword) {
  try {
    const masterSs = SpreadsheetApp.openById(MASTER_SHEET_ID);
    const userSheet = masterSs.getSheetByName("Users");
    const data = userSheet.getDataRange().getValues();
    const searchEmail = email.toLowerCase().trim();
    
    let rowIndex = -1;
    for (let i = 1; i < data.length; i++) {
      if (data[i][0].toString().toLowerCase().trim() === searchEmail) {
        rowIndex = i + 1;
        break;
      }
    }
    if (rowIndex === -1) return { success: false, message: "Akun tidak ditemukan!" };
    
    const dbOTP = data[rowIndex - 1][3] ? data[rowIndex - 1][3].toString().trim() : "";
    if (dbOTP === "" || dbOTP !== otpCode.trim()) return { success: false, message: "Kode OTP Salah!" };
    
    userSheet.getRange(rowIndex, 2).setValue(newPassword);
    userSheet.getRange(rowIndex, 4).setValue("");
    return { success: true, message: "Kata sandi sukses diperbarui!" };
  } catch(e) { return { success: false, message: e.toString() }; }
}

function loginUser(email, password) {
  const masterSs = SpreadsheetApp.openById(MASTER_SHEET_ID);
  const userSheet = masterSs.getSheetByName("Users");
  const data = userSheet.getDataRange().getValues();
  const searchEmail = email.toLowerCase().trim();
  
  for (let i = 1; i < data.length; i++) {
    if (data[i][0].toString().toLowerCase().trim() === searchEmail && data[i][1].toString() === password) {
      return { success: true, sheetId: data[i][2], email: data[i][0] };
    }
  }
  return { success: false, message: "Email atau Password salah!" };
}

function getDashboardData(sheetId) {
  try {
    const ss = SpreadsheetApp.openById(sheetId);
    const pocketSheet = ss.getSheetByName("Kantong");
    const pocketData = pocketSheet.getDataRange().getValues();
    let pockets = [];
    for (let i = 1; i < pocketData.length; i++) {
      pockets.push({
        name: pocketData[i][0],
        percentage: parseFloat(pocketData[i][1]),
        allocated: parseFloat(pocketData[i][2]) || 0,
        spent: parseFloat(pocketData[i][3]) || 0,
        remaining: (parseFloat(pocketData[i][2]) || 0) - (parseFloat(pocketData[i][3]) || 0),
        color: pocketData[i][4] || "#3b82f6",
        icon: pocketData[i][5] || "fa-solid fa-wallet"
      });
    }
    
    const txSheet = ss.getSheetByName("Transaksi");
    const txData = txSheet.getDataRange().getValues();
    let transactions = [];
    for (let i = txData.length - 1; i >= 1; i--) {
      transactions.push({
        index: i,
        date: safeParseDate(txData[i][0]),
        type: txData[i][1],
        pocket: txData[i][2],
        amount: parseFloat(txData[i][3]),
        notes: txData[i][4]
      });
    }
    return { success: true, pockets: pockets, transactions: transactions };
  } catch (e) { return { success: false, message: e.toString() }; }
}

function addTransaction(sheetId, type, pocketName, amount, notes, userEmail) {
  try {
    const ss = SpreadsheetApp.openById(sheetId);
    const txSheet = ss.getSheetByName("Transaksi");
    const pocketSheet = ss.getSheetByName("Kantong");
    amount = parseFloat(amount) || 0;
    
    let targetPocket = (type === "Pemasukan") ? "Semua" : pocketName;
    txSheet.appendRow([new Date(), type, targetPocket, amount, notes]);
    
    let pocketData = pocketSheet.getDataRange().getValues();
    let warningTriggered = false;
    let warningMessage = "";
    
    if (type === "Pemasukan") {
      for (let i = 1; i < pocketData.length; i++) {
        let pct = parseFloat(pocketData[i][1]) / 100;
        let allocation = amount * pct;
        pocketSheet.getRange(i + 1, 3).setValue((parseFloat(pocketData[i][2]) || 0) + allocation);
      }
    } else if (type === "Pengeluaran") {
      for (let i = 1; i < pocketData.length; i++) {
        if (pocketData[i][0] === pocketName) {
          let newSpent = (parseFloat(pocketData[i][3]) || 0) + amount;
          pocketSheet.getRange(i + 1, 4).setValue(newSpent);
          
          let isInvestment = /tabungan|saham|investasi|reksadana|deposito|savings|investment/i.test(pocketName);
          if (newSpent > parseFloat(pocketData[i][2]) && !isInvestment) {
            warningTriggered = true;
            warningMessage = "⚠️ Peringatan! Pengeluaran di Saku " + pocketName + " melebihi budget alokasi!";
            try {
              MailApp.sendEmail({
                to: userEmail,
                subject: "[JagoFamily Alert] Overbudget!",
                body: "Pengeluaran saku " + pocketName + " melebihi budget."
              });
            } catch(e){}
          }
          break;
        }
      }
    }
    return { success: true, warning: warningTriggered, msg: warningMessage };
  } catch (e) { return { success: false, message: e.toString() }; }
}

function updateTransactionInSheet(sheetId, txIndex, type, pocketName, amount, notes) {
  try {
    const ss = SpreadsheetApp.openById(sheetId);
    const txSheet = ss.getSheetByName("Transaksi");
    const pocketSheet = ss.getSheetByName("Kantong");
    const txData = txSheet.getDataRange().getValues();

    const rowNum = parseInt(txIndex);
    const oldType = txData[rowNum - 1][1];
    const oldPocket = txData[rowNum - 1][2];
    const oldAmount = parseFloat(txData[rowNum - 1][3]) || 0;
    amount = parseFloat(amount) || 0;

    let pocketData = pocketSheet.getDataRange().getValues();
    if (oldType === "Pemasukan") {
      for (let i = 1; i < pocketData.length; i++) {
        let pct = parseFloat(pocketData[i][1]) / 100;
        pocketSheet.getRange(i + 1, 3).setValue(Math.max(0, (parseFloat(pocketData[i][2]) || 0) - (oldAmount * pct)));
      }
    } else if (oldType === "Pengeluaran") {
      for (let i = 1; i < pocketData.length; i++) {
        if (pocketData[i][0] === oldPocket) {
          pocketSheet.getRange(i + 1, 4).setValue(Math.max(0, (parseFloat(pocketData[i][3]) || 0) - oldAmount));
          break;
        }
      }
    }

    pocketData = pocketSheet.getDataRange().getValues();
    let targetPocket = (type === "Pemasukan") ? "Semua" : pocketName;

    if (type === "Pemasukan") {
      for (let i = 1; i < pocketData.length; i++) {
        let pct = parseFloat(pocketData[i][1]) / 100;
        pocketSheet.getRange(i + 1, 3).setValue((parseFloat(pocketData[i][2]) || 0) + (amount * pct));
      }
    } else if (type === "Pengeluaran") {
      for (let i = 1; i < pocketData.length; i++) {
        if (pocketData[i][0] === pocketName) {
          pocketSheet.getRange(i + 1, 4).setValue((parseFloat(pocketData[i][3]) || 0) + amount);
          break;
        }
      }
    }

    txSheet.getRange(rowNum, 2).setValue(type);
    txSheet.getRange(rowNum, 3).setValue(targetPocket);
    txSheet.getRange(rowNum, 4).setValue(amount);
    txSheet.getRange(rowNum, 5).setValue(notes);
    return { success: true };
  } catch (e) { return { success: false, message: e.toString() }; }
}

function deleteTransaction(sheetId, txIndex) {
  try {
    const ss = SpreadsheetApp.openById(sheetId);
    const txSheet = ss.getSheetByName("Transaksi");
    const pocketSheet = ss.getSheetByName("Kantong");
    const txData = txSheet.getDataRange().getValues();
    
    const rowNum = parseInt(txIndex);
    const txType = txData[rowNum - 1][1];
    const txPocket = txData[rowNum - 1][2];
    const txAmount = parseFloat(txData[rowNum - 1][3]) || 0;
    
    let pocketData = pocketSheet.getDataRange().getValues();
    if (txType === "Pemasukan") {
      for (let i = 1; i < pocketData.length; i++) {
        let pct = parseFloat(pocketData[i][1]) / 100;
        pocketSheet.getRange(i + 1, 3).setValue(Math.max(0, (parseFloat(pocketData[i][2]) || 0) - (txAmount * pct)));
      }
    } else if (txType === "Pengeluaran") {
      for (let i = 1; i < pocketData.length; i++) {
        if (pocketData[i][0] === txPocket) {
          pocketSheet.getRange(i + 1, 4).setValue(Math.max(0, (parseFloat(pocketData[i][3]) || 0) - txAmount));
          break;
        }
      }
    }
    txSheet.deleteRow(rowNum);
    return { success: true };
  } catch (e) { return { success: false, message: e.toString() }; }
}

function addCustomPocket(sheetId, name, percentage, color, icon) {
  try {
    const ss = SpreadsheetApp.openById(sheetId);
    ss.getSheetByName("Kantong").appendRow([name, parseFloat(percentage), 0, 0, color, icon]);
    return { success: true };
  } catch (e) { return { success: false, message: e.toString() }; }
}

function updatePocketInSheet(sheetId, oldName, newName, percentage, color, icon) {
  try {
    const ss = SpreadsheetApp.openById(sheetId);
    const pocketSheet = ss.getSheetByName("Kantong");
    const pocketData = pocketSheet.getDataRange().getValues();
    
    for (let i = 1; i < pocketData.length; i++) {
      if (pocketData[i][0] === oldName) {
        pocketSheet.getRange(i + 1, 1).setValue(newName);
        pocketSheet.getRange(i + 1, 2).setValue(parseFloat(percentage));
        pocketSheet.getRange(i + 1, 5).setValue(color);
        pocketSheet.getRange(i + 1, 6).setValue(icon);
        break;
      }
    }
    if (oldName !== newName) {
      const txSheet = ss.getSheetByName("Transaksi");
      const txData = txSheet.getDataRange().getValues();
      for (let j = 1; j < txData.length; j++) {
        if (txData[j][2] === oldName) txSheet.getRange(j + 1, 3).setValue(newName);
      }
    }
    return { success: true };
  } catch (e) { return { success: false, message: e.toString() }; }
}

function deleteAndReallocatePocketInSheet(sheetId, pocketToDelete, targetPocket, redistributeMode) {
  try {
    const ss = SpreadsheetApp.openById(sheetId);
    const pocketSheet = ss.getSheetByName("Kantong");
    const pocketData = pocketSheet.getDataRange().getValues();
    
    let deleteAlloc = 0, deleteSpent = 0, deletePercentage = 0, deleteIndex = -1;
    for (let i = 1; i < pocketData.length; i++) {
      if (pocketData[i][0] === pocketToDelete) {
        deleteAlloc = parseFloat(pocketData[i][2]) || 0;
        deleteSpent = parseFloat(pocketData[i][3]) || 0;
        deletePercentage = parseFloat(pocketData[i][1]) || 0;
        deleteIndex = i + 1;
        break;
      }
    }
    if (deleteIndex === -1) return { success: false, message: "Saku tidak ditemukan." };
    
    for (let i = 1; i < pocketData.length; i++) {
      if (pocketData[i][0] === targetPocket) {
        pocketSheet.getRange(i + 1, 3).setValue((parseFloat(pocketData[i][2]) || 0) + deleteAlloc);
        pocketSheet.getRange(i + 1, 4).setValue((parseFloat(pocketData[i][3]) || 0) + deleteSpent);
        if (redistributeMode === "target") {
          pocketSheet.getRange(i + 1, 2).setValue((parseFloat(pocketData[i][1]) || 0) + deletePercentage);
        }
        break;
      }
    }
    if (redistributeMode === "split") {
      let remainingCount = pocketData.length - 2;
      if (remainingCount > 0) {
        let share = deletePercentage / remainingCount;
        for (let i = 1; i < pocketData.length; i++) {
          if (pocketData[i][0] !== pocketToDelete) {
            pocketSheet.getRange(i + 1, 2).setValue((parseFloat(pocketData[i][1]) || 0) + share);
          }
        }
      }
    }
    const txSheet = ss.getSheetByName("Transaksi");
    const txData = txSheet.getDataRange().getValues();
    for (let j = 1; j < txData.length; j++) {
      if (txData[j][2] === pocketToDelete) txSheet.getRange(j + 1, 3).setValue(targetPocket);
    }
    pocketSheet.deleteRow(deleteIndex);
    return { success: true };
  } catch (e) { return { success: false, message: e.toString() }; }
}

function transferPocketFunds(sheetId, source, target, amount) {
  try {
    const ss = SpreadsheetApp.openById(sheetId);
    const pocketSheet = ss.getSheetByName("Kantong");
    let pocketData = pocketSheet.getDataRange().getValues();
    amount = parseFloat(amount) || 0;
    
    for (let i = 1; i < pocketData.length; i++) {
      if (pocketData[i][0] === source) pocketSheet.getRange(i + 1, 3).setValue((parseFloat(pocketData[i][2]) || 0) - amount);
      if (pocketData[i][0] === target) pocketSheet.getRange(i + 1, 3).setValue((parseFloat(pocketData[i][2]) || 0) + amount);
    }
    return { success: true };
  } catch (e) { return { success: false, message: e.toString() }; }
}
