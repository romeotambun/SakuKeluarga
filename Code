// 5. AMBIL DATA DASHBOARD USER (KANTONG & TRANSAKSI)
function getDashboardData(sheetId) {
  try {
    const ss = SpreadsheetApp.openById(sheetId);
    
    const pocketSheet = ss.getSheetByName("Kantong");
    const pocketData = pocketSheet.getDataRange().getValues();
    let pockets = [];
    for (let i = 1; i < pocketData.length; i++) {
      pockets.push({
        name: pocketData[i][0],
        percentage: parseFloat(pocketData[i][1]),
        allocated: parseFloat(pocketData[i][2]) || 0,
        spent: parseFloat(pocketData[i][3]) || 0,
        remaining: (parseFloat(pocketData[i][2]) || 0) - (parseFloat(pocketData[i][3]) || 0),
        color: pocketData[i][4] || "#3b82f6",
        icon: pocketData[i][5] || "fa-solid fa-wallet"
      });
    }
    
    const txSheet = ss.getSheetByName("Transaksi");
    const txData = txSheet.getDataRange().getValues();
    let transactions = [];
    for (let i = txData.length - 1; i >= 1; i--) {
      let dateObj = txData[i][0];
      let dateString = safeParseDate(dateObj); // Memanggil parser tanggal tangguh
      transactions.push({
        index: i,
        date: dateString,
        type: txData[i][1],
        pocket: txData[i][2],
        amount: parseFloat(txData[i][3]),
        notes: txData[i][4]
      });
    }
    
    return { success: true, pockets: pockets, transactions: transactions };
  } catch (e) {
    return { success: false, message: e.toString() };
  }
}

// 6. CATAT TRANSAKSI (SINKRONISASI STABIL & AKURAT)
function addTransaction(sheetId, type, pocketName, amount, notes, userEmail) {
  try {
    const ss = SpreadsheetApp.openById(sheetId);
    const txSheet = ss.getSheetByName("Transaksi");
    const pocketSheet = ss.getSheetByName("Kantong");
    
    amount = parseFloat(amount) || 0;
    const date = new Date();
    
    let targetPocket = (type === "Pemasukan") ? "Semua" : pocketName;
    txSheet.appendRow([date, type, targetPocket, amount, notes]);
    
    let pocketData = pocketSheet.getDataRange().getValues();
    let warningTriggered = false;
    let warningMessage = "";
    
    if (type === "Pemasukan") {
      for (let i = 1; i < pocketData.length; i++) {
        let pct = parseFloat(pocketData[i][1]) / 100;
        let allocation = amount * pct;
        let currentAllocated = parseFloat(pocketData[i][2]) || 0;
        
        pocketSheet.getRange(i + 1, 3).setValue(currentAllocated + allocation);
      }
    } else if (type === "Pengeluaran") {
      for (let i = 1; i < pocketData.length; i++) {
        if (pocketData[i][0] === pocketName) {
          let currentSpent = parseFloat(pocketData[i][3]) || 0;
          let totalAllocated = parseFloat(pocketData[i][2]) || 0;
          let newSpent = currentSpent + amount;
          
          pocketSheet.getRange(i + 1, 4).setValue(newSpent);
          
          // Cek jika melebihi budget kantong (Dikecualikan untuk tabungan / investasi / saham)
          let isInvestment = /tabungan|saham|investasi|reksadana|deposito|savings|investment/i.test(pocketName);
          if (newSpent > totalAllocated && !isInvestment) {
            warningTriggered = true;
            warningMessage = "⚠️ Peringatan! Pengeluaran di Saku " + pocketName + " telah melebihi budget alokasi!";
            
            try {
              MailApp.sendEmail({
                to: userEmail,
                subject: "[JagoFamily Alert] Saku " + pocketName + " Overbudget!",
                body: "Halo, pengeluaran saku " + pocketName + " telah melebihi budget.\nTotal Pengeluaran: Rp " + newSpent.toLocaleString()
              });
            } catch(mailErr) {}
          }
          break;
        }
      }
    }
    return { success: true, warning: warningTriggered, msg: warningMessage };
  } catch (e) {
    return { success: false, message: e.toString() };
  }
}

// 7. EDIT / UPDATE TRANSAKSI DENGAN INTEGRAL REVERSAL DAN REALLOCATION
function updateTransactionInSheet(sheetId, txIndex, type, pocketName, amount, notes) {
  try {
    const ss = SpreadsheetApp.openById(sheetId);
    const txSheet = ss.getSheetByName("Transaksi");
    const pocketSheet = ss.getSheetByName("Kantong");
    const txData = txSheet.getDataRange().getValues();

    const rowNum = parseInt(txIndex);
    const oldType = txData[rowNum - 1][1];
    const oldPocket = txData[rowNum - 1][2];
    const oldAmount = parseFloat(txData[rowNum - 1][3]) || 0;

    amount = parseFloat(amount) || 0;

    // A. PEMULIHAN HISTORIS (REVERSAL)
    let pocketData = pocketSheet.getDataRange().getValues();
    if (oldType === "Pemasukan") {
      for (let i = 1; i < pocketData.length; i++) {
        let pct = parseFloat(pocketData[i][1]) / 100;
        let allocationToDeduct = oldAmount * pct;
        let currentAllocated = parseFloat(pocketData[i][2]) || 0;
        pocketSheet.getRange(i + 1, 3).setValue(Math.max(0, currentAllocated - allocationToDeduct));
      }
    } else if (oldType === "Pengeluaran") {
      for (let i = 1; i < pocketData.length; i++) {
        if (pocketData[i][0] === oldPocket) {
          let currentSpent = parseFloat(pocketData[i][3]) || 0;
          pocketSheet.getRange(i + 1, 4).setValue(Math.max(0, currentSpent - oldAmount));
          break;
        }
      }
    }

    // Ambil data terbaru saku setelah pemulihan
    pocketData = pocketSheet.getDataRange().getValues();

    // B. PENERAPAN NILAI BARU (APPLY NEW STATE)
    let targetPocket = (type === "Pemasukan") ? "Semua" : pocketName;

    if (type === "Pemasukan") {
      for (let i = 1; i < pocketData.length; i++) {
        let pct = parseFloat(pocketData[i][1]) / 100;
        let allocation = amount * pct;
        let currentAllocated = parseFloat(pocketData[i][2]) || 0;
        pocketSheet.getRange(i + 1, 3).setValue(currentAllocated + allocation);
      }
    } else if (type === "Pengeluaran") {
      for (let i = 1; i < pocketData.length; i++) {
        if (pocketData[i][0] === pocketName) {
          let currentSpent = parseFloat(pocketData[i][3]) || 0;
          pocketSheet.getRange(i + 1, 4).setValue(currentSpent + amount);
          break;
        }
      }
    }

    // Tulis update pada baris baris di sheet Transaksi
    txSheet.getRange(rowNum, 2).setValue(type);
    txSheet.getRange(rowNum, 3).setValue(targetPocket);
    txSheet.getRange(rowNum, 4).setValue(amount);
    txSheet.getRange(rowNum, 5).setValue(notes);

    return { success: true };
  } catch (e) {
    return { success: false, message: e.toString() };
  }
}

// 8. HAPUS TRANSAKSI & PEMULIHAN SALDO
function deleteTransaction(sheetId, txIndex) {
  try {
    const ss = SpreadsheetApp.openById(sheetId);
    const txSheet = ss.getSheetByName("Transaksi");
    const pocketSheet = ss.getSheetByName("Kantong");
    const txData = txSheet.getDataRange().getValues();
    
    const rowNum = txIndex;
    const txType = txData[rowNum - 1][1];
    const txPocket = txData[rowNum - 1][2];
    const txAmount = parseFloat(txData[rowNum - 1][3]) || 0;
    
    let pocketData = pocketSheet.getDataRange().getValues();
    if (txType === "Pemasukan") {
      for (let i = 1; i < pocketData.length; i++) {
        let pct = parseFloat(pocketData[i][1]) / 100;
        let allocationToDeduct = txAmount * pct;
        let currentAllocated = parseFloat(pocketData[i][2]) || 0;
        pocketSheet.getRange(i + 1, 3).setValue(Math.max(0, currentAllocated - allocationToDeduct));
      }
    } else if (txType === "Pengeluaran") {
      for (let i = 1; i < pocketData.length; i++) {
        if (pocketData[i][0] === txPocket) {
          let currentSpent = parseFloat(pocketData[i][3]) || 0;
          pocketSheet.getRange(i + 1, 4).setValue(Math.max(0, currentSpent - txAmount));
          break;
        }
      }
    }
    
    txSheet.deleteRow(rowNum);
    return { success: true };
  } catch (e) {
    return { success: false, message: e.toString() };
  }
}

