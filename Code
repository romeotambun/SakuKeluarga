// 2. FORGOT PASSWORD (OTP GENERATION & MAIL)
function forgotPassword(email) {
  try {
    const masterSs = SpreadsheetApp.openById(MASTER_SHEET_ID);
    const userSheet = masterSs.getSheetByName("Users");
    const data = userSheet.getDataRange().getValues();
    const searchEmail = email.toLowerCase().trim();
    
    let rowIndex = -1;
    for (let i = 1; i < data.length; i++) {
      if (data[i][0].toString().toLowerCase().trim() === searchEmail) {
        rowIndex = i + 1;
        break;
      }
    }
    
    if (rowIndex === -1) {
      return { success: false, message: "Email tidak ditemukan dalam sistem!" };
    }
    
    // Generate 6 digit pin
    const otp = Math.floor(100000 + Math.random() * 900000).toString();
    userSheet.getRange(rowIndex, 4).setValue(otp); // Catat di kolom ke-4
    
    // Kirim email OTP
    MailApp.sendEmail({
      to: email,
      subject: "[SakuHarmoni] Kode Keamanan Verifikasi Setel Ulang Sandi",
      body: "Halo, kami menerima permintaan setel ulang sandi untuk akun Hub Keuangan SakuHarmoni Anda.\n\n" +
            "Gunakan Kode Keamanan OTP berikut untuk melanjutkan proses verifikasi:\n\n" +
            "▶ OTP: " + otp + "\n\n" +
            "Jika Anda tidak meminta ini, abaikan email ini secara aman."
    });
    
    return { success: true, message: "Kode keamanan OTP berhasil dikirim ke email!" };
  } catch (e) {
    return { success: false, message: "Gagal memproses OTP: " + e.toString() };
  }
}

// 3. RESET PASSWORD DENGAN OTP VERIFICATION
function resetPasswordWithCode(email, otpCode, newPassword) {
  try {
    const masterSs = SpreadsheetApp.openById(MASTER_SHEET_ID);
    const userSheet = masterSs.getSheetByName("Users");
    const data = userSheet.getDataRange().getValues();
    const searchEmail = email.toLowerCase().trim();
    
    let rowIndex = -1;
    for (let i = 1; i < data.length; i++) {
      if (data[i][0].toString().toLowerCase().trim() === searchEmail) {
        rowIndex = i + 1;
        break;
      }
    }
    
    if (rowIndex === -1) return { success: false, message: "Akun tidak ditemukan!" };
    
    const dbOTP = data[rowIndex - 1][3] ? data[rowIndex - 1][3].toString().trim() : "";
    if (dbOTP === "" || dbOTP !== otpCode.trim()) {
      return { success: false, message: "Kode OTP Salah atau Kadaluwarsa!" };
    }
    
    // Update Password di kolom ke-2 & reset OTP ke kosong
    userSheet.getRange(rowIndex, 2).setValue(newPassword);
    userSheet.getRange(rowIndex, 4).setValue("");
    
    return { success: true, message: "Kata sandi sukses diperbarui! Silahkan login." };
  } catch(e) {
    return { success: false, message: e.toString() };
  }
}

