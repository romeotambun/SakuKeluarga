// HANDLER UTAMA UNTUK MENERIMA REQUEST DARI GITHUB PAGES
function doPost(e) {
  try {
    const requestData = JSON.parse(e.postData.contents);
    const action = requestData.action;
    const payload = requestData.payload || {};
    let result;

    switch(action) {
      case 'registerUser':
        result = registerUser(payload.email, payload.password);
        break;
      case 'loginUser':
        result = loginUser(payload.email, payload.password);
        break;
      case 'getDashboardData':
        result = getDashboardData(payload.sheetId);
        break;
      case 'addTransaction':
        result = addTransaction(payload.sheetId, payload.type, payload.pocketName, payload.amount, payload.notes, payload.userEmail);
        break;
      case 'updateTransaction':
        result = updateTransactionInSheet(payload.sheetId, payload.txIndex, payload.type, payload.pocketName, payload.amount, payload.notes);
        break;
      case 'deleteTransaction':
        result = deleteTransaction(payload.sheetId, payload.txIndex);
        break;
      case 'addCustomPocket':
        result = addCustomPocket(payload.sheetId, payload.name, payload.percentage, payload.color, payload.icon);
        break;
      case 'updatePocket':
        result = updatePocketInSheet(payload.sheetId, payload.oldName, payload.newName, payload.percentage, payload.color, payload.icon);
        break;
      case 'deleteAndReallocatePocket':
        result = deleteAndReallocatePocketInSheet(payload.sheetId, payload.pocketToDelete, payload.targetPocket, payload.redistributeMode);
        break;
      case 'transferPocketFunds':
        result = transferPocketFunds(payload.sheetId, payload.source, payload.target, payload.amount);
        break;
      case 'forgotPassword':
        result = forgotPassword(payload.email);
        break;
      case 'resetPasswordWithCode':
        result = resetPasswordWithCode(payload.email, payload.otpCode, payload.newPassword);
        break;
      default:
        result = { success: false, message: "Aksi tidak dikenali oleh sistem API!" };
    }

    return ContentService.createTextOutput(JSON.stringify(result))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({ success: false, message: "API Error: " + err.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

