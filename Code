// 10. EDIT / UPDATE ATRIBUT KANTONG
function updatePocketInSheet(sheetId, oldName, newName, percentage, color, icon) {
  try {
    const ss = SpreadsheetApp.openById(sheetId);
    const pocketSheet = ss.getSheetByName("Kantong");
    const pocketData = pocketSheet.getDataRange().getValues();
    
    for (let i = 1; i < pocketData.length; i++) {
      if (pocketData[i][0] === oldName) {
        pocketSheet.getRange(i + 1, 1).setValue(newName);
        pocketSheet.getRange(i + 1, 2).setValue(parseFloat(percentage));
        pocketSheet.getRange(i + 1, 5).setValue(color);
        pocketSheet.getRange(i + 1, 6).setValue(icon);
        break;
      }
    }
    
    if (oldName !== newName) {
      const txSheet = ss.getSheetByName("Transaksi");
      const txData = txSheet.getValues();
      for (let j = 1; j < txData.length; j++) {
        if (txData[j][2] === oldName) {
          txSheet.getRange(j + 1, 3).setValue(newName);
        }
      }
    }
    return { success: true };
  } catch (e) {
    return { success: false, message: e.toString() };
  }
}

// 11. HAPUS & REALOKASI KANTONG
function deleteAndReallocatePocketInSheet(sheetId, pocketToDelete, targetPocket, redistributeMode) {
  try {
    const ss = SpreadsheetApp.openById(sheetId);
    const pocketSheet = ss.getSheetByName("Kantong");
    const pocketData = pocketSheet.getDataRange().getValues();
    
    let deleteAlloc = 0;
    let deleteSpent = 0;
    let deletePercentage = 0;
    let deleteIndex = -1;
    
    for (let i = 1; i < pocketData.length; i++) {
      if (pocketData[i][0] === pocketToDelete) {
        let deleteAlloc = parseFloat(pocketData[i][2]) || 0;
        let deleteSpent = parseFloat(pocketData[i][3]) || 0;
        let deletePercentage = parseFloat(pocketData[i][1]) || 0;
        deleteIndex = i + 1;
        break;
      }
    }
    
    if (deleteIndex === -1) return { success: false, message: "Saku sumber tidak ditemukan." };
    
    for (let i = 1; i < pocketData.length; i++) {
      if (pocketData[i][0] === targetPocket) {
        let currentAlloc = parseFloat(pocketData[i][2]) || 0;
        let currentSpent = parseFloat(pocketData[i][3]) || 0;
        
        pocketSheet.getRange(i + 1, 3).setValue(currentAlloc + deleteAlloc);
        pocketSheet.getRange(i + 1, 4).setValue(currentSpent + deleteSpent);
        
        if (redistributeMode === "target") {
          let currentPct = parseFloat(pocketData[i][1]) || 0;
          pocketSheet.getRange(i + 1, 2).setValue(currentPct + deletePercentage);
        }
        break;
      }
    }
    
    if (redistributeMode === "split") {
      let remainingCount = pocketData.length - 2;
      if (remainingCount > 0) {
        let share = deletePercentage / remainingCount;
        for (let i = 1; i < pocketData.length; i++) {
          if (pocketData[i][0] !== pocketToDelete) {
            let currentPct = parseFloat(pocketData[i][1]) || 0;
            pocketSheet.getRange(i + 1, 2).setValue(currentPct + share);
          }
        }
      }
    }
    
    const txSheet = ss.getSheetByName("Transaksi");
    const txData = txSheet.getDataRange().getValues();
    for (let j = 1; j < txData.length; j++) {
      if (txData[j][2] === pocketToDelete) {
        txSheet.getRange(j + 1, 3).setValue(targetPocket);
      }
    }
    
    pocketSheet.deleteRow(deleteIndex);
    return { success: true };
  } catch (e) {
    return { success: false, message: e.toString() };
  }
}

// 12. PINDAH SALDO ANTAR SAKU (TRANSFER INTERNAL)
function transferPocketFunds(sheetId, source, target, amount) {
  try {
    const ss = SpreadsheetApp.openById(sheetId);
    const pocketSheet = ss.getSheetByName("Kantong");
    let pocketData = pocketSheet.getDataRange().getValues();
    
    amount = parseFloat(amount) || 0;
    let srcFound = false;
    let tgtFound = false;
    
    for (let i = 1; i < pocketData.length; i++) {
      if (pocketData[i][0] === source) {
        let currentAllocated = parseFloat(pocketData[i][2]) || 0;
        pocketSheet.getRange(i + 1, 3).setValue(currentAllocated - amount);
        srcFound = true;
      }
      if (pocketData[i][0] === target) {
        let currentAllocated = parseFloat(pocketData[i][2]) || 0;
        pocketSheet.getRange(i + 1, 3).setValue(currentAllocated + amount);
        tgtFound = true;
      }
    }
    if (srcFound && tgtFound) return { success: true };
    return { success: false, message: "Kantong tidak ditemukan." };
  } catch (e) {
    return { success: false, message: e.toString() };
  }
}

